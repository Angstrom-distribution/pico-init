#
# netd's own unit. Deliberately no After=eudev.service: netlink
# event subscription makes interface appearance order-independent (netd-
# link.h), which is the whole point of netd_startup()'s subscribe-before-
# enumerate ordering. Enablement follows the preset flow like every other
# unit; this ships WantedBy=default.target so the distribution's preset file
# alone decides whether it is actually enabled.

[Unit]
Description=pico network daemon
Before=network.target

[Service]
ExecStart=/usr/sbin/netd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
