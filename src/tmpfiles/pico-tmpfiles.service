#
# systemd-tmpfiles-setup.service's own shape and ordering: a oneshot that
# runs Before=sysinit.target, with --boot so `!` lines apply. No After= for
# a writable /var is needed here: pico-init remounts the root filesystem
# read-write and mounts /run before it starts a single unit (root-check.h,
# mount-setup.c), and there are no separate .mount units to wait for.
#
# --remove as upstream passes it, so r/R lines and D directories are cleared
# at boot before creation runs. The age-based --clean belongs to a periodic
# job (upstream's systemd-tmpfiles-clean.timer), not to boot. Enablement
# follows the preset flow like every other unit: this ships
# WantedBy=sysinit.target, upstream's own hook, and the preset alone decides.

[Unit]
Description=Create System Files and Directories
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/pico-tmpfiles --create --remove --boot

[Install]
WantedBy=sysinit.target
