#
#  Same shape as real systemd's libudev.pc (libudev-v262.pc.in);
#  test-libudev-pc keeps it that way.

prefix=@PREFIX@
exec_prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDE_DIR@

Name: libudev
Description: Library to access udev device information (pico-init's libudev shim)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ludev
Cflags: -I${includedir}
