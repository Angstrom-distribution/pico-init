#
# Persistent names for USB serial adapters.
#
# /dev/ttyUSB0 is whichever adapter enumerated first, which is not a fact about
# the adapter. This file gives each one a name derived from what it says about
# itself, so a script can open the same device across reboots and across which
# port it happens to be in.
#
# It ships with devd and is written in devd's own subset of udev-rules syntax,
# which is the dogfooding half of the drop-in-compatibility decision: the engine
# that consumes usb-modeswitch's file also consumes one this project wrote, in
# the same syntax, with no pico-only extension anywhere in it.
#
# Upstream builds the same name in 60-serial.rules out of three udev builtins
# (usb_id, hwdb, path_id). Reading usb_id shows every input it needs is a plain
# sysfs attribute -- manufacturer, product and serial on the USB device,
# bInterfaceNumber on the interface -- so $attr{} substitution, which walks the
# parent chain for each, replaces all three builtins here.
#
# Names match upstream's: vendor_model[_serial] with hex IDs standing in for a
# missing descriptor string, and a -port<N> suffix on ttyUSB (never ttyACM). The
# one divergence from upstream's links is that there is no by-path link
# (path_id is topology-walking C with no sysfs shortcut).

ACTION=="remove", GOTO="pico_serial_end"
SUBSYSTEM!="tty", GOTO="pico_serial_end"
KERNEL!="ttyUSB*|ttyACM*", GOTO="pico_serial_end"

# No interface number, no stable name.
ENV{.PICO_IF}="$attr{bInterfaceNumber}"
ENV{.PICO_IF}=="", GOTO="pico_serial_end"

ENV{.PICO_VENDOR}="$attr{manufacturer}"
ENV{.PICO_VENDOR}=="", ENV{.PICO_VENDOR}="$attr{idVendor}"
ENV{.PICO_MODEL}="$attr{product}"
ENV{.PICO_MODEL}=="", ENV{.PICO_MODEL}="$attr{idProduct}"

# The underscore belongs to the serial, so an adapter without one has none.
ENV{.PICO_SERIAL}="$attr{serial}"
ENV{.PICO_SERIAL}=="?*", ENV{.PICO_SERIAL}="_$env{.PICO_SERIAL}"

# Only usb-serial ports carry port_number, so ttyACM stays suffix-free.
ENV{.PICO_PORT}="$attr{port_number}"
ENV{.PICO_PORT}=="", SYMLINK+="serial/by-id/usb-$env{.PICO_VENDOR}_$env{.PICO_MODEL}$env{.PICO_SERIAL}-if$env{.PICO_IF}"
ENV{.PICO_PORT}=="?*", SYMLINK+="serial/by-id/usb-$env{.PICO_VENDOR}_$env{.PICO_MODEL}$env{.PICO_SERIAL}-if$env{.PICO_IF}-port$env{.PICO_PORT}"

LABEL="pico_serial_end"
